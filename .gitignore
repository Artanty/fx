back/h90/patchstorage/

# Pedal randomizer local DB (created at runtime by the backends)
back/lalady/randomizer-data/
back/c4/randomizer-data/

# SikuliX runtime (jars + portable JRE - fetch with back/h90/sikulix/setup.ps1)
back/h90/sikulix/sikulixide-*.jar
back/h90/sikulix/sikulixapi-*.jar
back/h90/sikulix/jre/

# Capstone disassembler source checkout (pip `capstone` wheel replaces it)
input/capstone-next/

# System
.DS_Store

# Compiled helpers (build from the .swift sources)
back/h90/h90_proxy
back/h90/test-selfsource
back/h90/test-send-to-source
back/h90/ble-connect
back/h90/ble-scan
back/h90/h90_relay
