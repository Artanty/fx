# Dependencies / build
node_modules/
dist/
.angular/

# ...but keep the Angular source module also named dist (web/src/app/dist)
!web/src/app/dist/
!web/src/app/dist/**

# Python
__pycache__/
*.pyc

# Generated / downloaded data (regenerate with `python3 back/h90/build_db.py`)
back/h90/presets.db
